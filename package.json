{
  "name": "cvl-for-office",
  "private": true,
  "version": "0.0.0",
  "description": "Chinese Variants Linter for Microsoft Office (Word / Excel / PowerPoint).",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "compile": "tsc -b packages/core packages/ui",
    "test": "vitest run",
    "start:ms": "npm run start -w @cvl/host-ms",
    "stop:ms": "npm run stop -w @cvl/host-ms",
    "build:ms": "npm run build -w @cvl/host-ms",
    "validate:ms": "npm run validate -w @cvl/host-ms",
    "sync:vectors": "node scripts/sync-test-vectors.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  }
}
